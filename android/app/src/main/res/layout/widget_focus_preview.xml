<?xml version="1.0" encoding="utf-8"?>
<!-- Превью в списке виджетов (Android 12+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/w_focus_title" android:textColor="@color/widget_text" android:textSize="15sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pv_focus_sub" android:textColor="@color/widget_text2" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:text="25:00" android:textColor="@color/widget_text" android:textSize="34sp" />
    <TextView android:layout_width="match_parent" android:layout_height="36dp" android:background="@drawable/widget_pill_accent" android:gravity="center" android:text="@string/w_focus_start" android:textColor="@color/widget_on_accent" android:textSize="13sp" android:textStyle="bold" />
</LinearLayout>
