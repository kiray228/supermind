<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_hb_chip"
    android:layout_width="0dp"
    android:layout_height="52dp"
    android:layout_margin="3dp"
    android:layout_weight="1"
    android:background="@drawable/widget_chip_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp">

        <ImageView
            android:id="@+id/w_hb_icon_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_oval_white" />

        <TextView
            android:id="@+id/w_hb_emoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_hb_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_hb_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text2"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/w_hb_btn"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:contentDescription="Отметить">

        <ImageView
            android:id="@+id/w_hb_check_ring"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_ring_white" />

        <ProgressBar
            android:id="@+id/w_hb_prog"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminate="false"
            android:max="1"
            android:progress="0"
            android:progressDrawable="@drawable/widget_ring_progress"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/w_hb_fill"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_oval_white"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/w_hb_tick"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_tick"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_hb_cnt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
