<?xml version="1.0" encoding="utf-8"?>
<!-- Превью в списке виджетов (Android 12+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/w_fin_title" android:textColor="@color/widget_text" android:textSize="16sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="34dp" android:background="@drawable/widget_pill_accent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="12dp">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_widget_add" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp" android:text="@string/w_add_expense" android:textColor="@color/widget_on_accent" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/w_today_title" android:textColor="@color/widget_text2" android:textSize="12sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pv_fin_today" android:textColor="@color/widget_text" android:textSize="24sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pv_fin_month" android:textColor="@color/widget_text" android:textSize="13sp" />
    <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:max="100" android:progress="62" android:progressDrawable="@drawable/widget_progress" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/pv_fin_left" android:textColor="@color/widget_text2" android:textSize="11sp" />
</LinearLayout>
