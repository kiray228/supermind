<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="12dp"
    android:paddingEnd="11dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <LinearLayout
            android:id="@+id/w_hb_header"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Привычки"
                android:textColor="@color/widget_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_hb_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text2"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_hb_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/widget_accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/w_hb_ring"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:indeterminate="false"
            android:max="1"
            android:progress="0"
            android:progressDrawable="@drawable/widget_ring_progress"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_hb_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/w_hb_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_text2"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_hb_more"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="6dp"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
