<?xml version="1.0" encoding="utf-8"?>
<!-- Внешняя рамка даёт отступ между карточками (у элементов ListView поля не работают) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/w_ci"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_chip_bg"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_ci_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_ci_end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text2"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_ci_bar"
            android:layout_width="4dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_bar" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_ci_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/widget_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/w_ci_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/widget_text2"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
