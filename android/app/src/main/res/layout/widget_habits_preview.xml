<?xml version="1.0" encoding="utf-8"?>
<!-- Превью в списке виджетов (Android 12+) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingStart="11dp"
    android:paddingTop="12dp"
    android:paddingEnd="11dp"
    android:paddingBottom="10dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="3dp" android:paddingEnd="3dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Привычки" android:textColor="@color/widget_text" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SuperMind" android:textColor="@color/widget_text2" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="1 из 2" android:textColor="@color/widget_accent" android:textSize="14sp" android:textStyle="bold" />
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="34dp" android:layout_height="34dp" android:max="2" android:progress="1" android:progressDrawable="@drawable/widget_ring_progress" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/widget_chip_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧" android:textSize="18sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Пить воду" android:textColor="@color/widget_text" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 из 8 стаканов  ·  🔥 5 дней" android:textColor="@color/widget_text2" android:textSize="11sp" />
        </LinearLayout>
        <ProgressBar style="?android:attr/progressBarStyleHorizontal" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="9dp" android:max="8" android:progress="3" android:progressDrawable="@drawable/widget_ring_progress" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_margin="3dp" android:background="@drawable/widget_chip_bg" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏃" android:textSize="18sp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Пробежка" android:textColor="@color/widget_text2" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 12 дней" android:textColor="@color/widget_text2" android:textSize="11sp" />
        </LinearLayout>
        <FrameLayout android:layout_width="32dp" android:layout_height="32dp" android:layout_marginEnd="9dp">
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_oval_white" android:tint="#22C55E" />
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_widget_tick" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
