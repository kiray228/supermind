{
  "name": "SuperMind — интеллект-карты, задачи, ежедневник",
  "short_name": "SuperMind",
  "description": "Бесплатные интеллект-карты с ИИ, доска задач и ежедневник. Работает офлайн.",
  "lang": "ru",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6f6f8",
  "theme_color": "#10B981",
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "share-title", "text": "share-text", "url": "share-url" }
  },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
