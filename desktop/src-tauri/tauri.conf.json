{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperMind",
  "mainBinaryName": "SuperMind",
  "version": "1.25.0",
  "identifier": "app.twomind.supermind",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SuperMind",
    "copyright": "SuperMind",
    "shortDescription": "SuperMind — интеллект-карты, задачи, ежедневник",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
